# Compose 环境变量模板。
# 复制为 docker/.env.unix（macOS / Linux / WSL）或 docker/.env.window（Windows），
# 脚本按当前平台优先加载同名文件，找不到再退回 docker/.env。
# 这两个实际文件已被 .gitignore 忽略，可放心写本机路径与密钥。

# 持久化数据根目录：MySQL、Redis、Nacos 的 data/logs 四个目录都建在它下面。
# macOS / Linux：
FS_DATA_PATH=/Volumes/WD_BLACK/docker/docker_files
# Windows（Docker Desktop）改成盘符绝对路径，并注释掉上面一行：
# FS_DATA_PATH=D:/docker/fullstack-scaffold-data

# 宿主端口：只影响对外映射，容器内端口固定。
ADMIN_BIND_IP=127.0.0.1
MYSQL_PORT=13306
REDIS_PORT=6379
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_SERVER_PORT=9849
GATEWAY_PORT=8080
WEB_REACT_PORT=5173
WEB_VUE_PORT=5174
# 留空 = actuator 与应用同端口
MANAGEMENT_PORT=

# dev / test / prod，切到 prod 需同时补齐密钥
SPRING_PROFILES_ACTIVE=dev
AUTH_TYPE=JWT

# 生产必须替换成自己的值（至少 32 字节），不要沿用这里的默认串
AUTH_JWT_SECRET=fullstack-scaffold-default-secret-please-change-it-32bytes
AUTH_GATEWAY_SECRET=fullstack-scaffold-dev-gateway-secret

# 镜像标签：留 latest 时每次构建会覆盖同名镜像
IMAGE_TAG=latest
