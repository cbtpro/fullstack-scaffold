<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scaffold</groupId>
        <artifactId>fullstack-scaffold-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>user-service</artifactId>
    <name>user-service</name>
    <description>示例业务服务：用户 CRUD + 登录，演示 auth-starter 双鉴权切换</description>

    <dependencies>
        <!-- Servlet web + actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 可观测性：Prometheus 指标暴露 + Brave 桥接的链路追踪（traceId 贯穿日志、跨服务传播） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- 鉴权 Starter：JWT（默认）或 SA_TOKEN，改 auth.type 即可切换 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>auth-starter</artifactId>
        </dependency>

        <!-- 验证码 Starter：三层 Bean（生成/渲染/缓存），默认 Redis 缓存 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>captcha-starter</artifactId>
        </dependency>

        <!-- 全局 ID Starter：统一 Snowflake 主键 + Worker ID 管理 + 全局序列分配器 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>id-starter</artifactId>
        </dependency>

        <!-- Sa-Token：仅 auth.type=SA_TOKEN 时启用。
             不在此引入也可，按需手动加，或通过 profile 切换。
             为演示双鉴权可切换，默认引入（JWT 模式下 Bean 不装配，依赖无副作用）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway：表结构版本管理，V1 为历史 init.sql 的基线，后续表演出走 V2+ -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 9.16 起 MySQL 方言独立为 flyway-mysql，MySQL 8 必需 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Redis（Sa-Token 会话存储可选；JWT 模式下用于缓存扩展点） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- API 文档：knife4j（内含 springdoc-openapi-starter-webmvc-ui） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- 工具集 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers：本机 Docker 29.x 与 TC 1.19.x 的 docker-java 客户端 API
             版本协商失败（/_ping 返回 400），集成测试改用独立 MySQL 实例。
             若部署环境 Docker 版本匹配，取消注释即可切回 Testcontainers。
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- macOS 外置卷（exFAT）会为每个写入的文件生成 ._* AppleDouble 副本，
                         其中 ._Xxx.class 会被 Spring 类路径扫描当作非法 class 解析导致启动失败。
                         开启该开关让扫描阶段跳过无法解析的文件。 -->
                    <argLine>-Dspring.classformat.ignore=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
