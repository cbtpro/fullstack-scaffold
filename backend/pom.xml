<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.scaffold</groupId>
    <artifactId>fullstack-scaffold-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fullstack-scaffold-backend</name>
    <description>fullstack-scaffold 后端多模块父 pom，统一版本管理与依赖治理</description>

    <modules>
        <module>common</module>
        <module>auth-starter</module>
        <module>captcha-starter</module>
        <module>id-starter</module>
        <module>gateway-service</module>
        <module>user-service</module>
        <module>../docker/web-react</module>
        <module>../docker/web-vue</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <!-- Docker 操作仅显式启用 profile 时执行；validate 不编译业务代码。 -->
        <docker.action>status</docker.action>
        <docker.phase>validate</docker.phase>
        <!-- 留空表示优先采用 docker/.env.<平台> 里的 FS_DATA_PATH；显式 -Ddocker.data.dir 可覆盖 -->
        <docker.data.dir></docker.data.dir>
        <docker.wait.timeout>240</docker.wait.timeout>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Spring Boot 3 / Spring Framework 6 要求参数名可反射，否则 @RequestParam(required=false) String name
             会因找不到参数名抛 IllegalArgumentException，被 SecurityFilterChain 转成 403。
             不继承 spring-boot-starter-parent 时必须显式开启。 -->
        <maven.compiler.parameters>true</maven.compiler.parameters>

        <!-- 框架版本：严格对应，禁止被动升级 -->
        <spring-boot.version>3.2.5</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>

        <!-- 业务库版本 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <sa-token.version>1.39.0</sa-token.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.3.0</springdoc.version>
        <knife4j.version>4.4.0</knife4j.version>
        <lombok.version>1.18.32</lombok.version>
        <hutool.version>5.8.27</hutool.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <!-- Spring Boot 3.2.5 BOM 默认 1.19.7，本地仓库仅有 1.19.8 的完整产物 -->
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.scaffold</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.scaffold</groupId>
                <artifactId>auth-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>captcha-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>id-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Plus（已兼容 Spring Boot 3.x） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

            <!-- Sa-Token（Spring Boot 3 starter） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- jjwt 0.12.x（新 API） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Springdoc OpenAPI（Spring Boot 3.x 适配） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Knife4j：基于 springdoc 的增强 UI（/doc.html），内含 springdoc 依赖 -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>${maven.compiler.parameters}</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <!-- 非 spring-boot-starter-parent，需显式绑定 repackage 到 package 阶段
                             否则打出的 jar 无 Main-Class，无法 java -jar 运行 -->
                        <execution>
                            <id>repackage</id>
                            <goals><goal>repackage</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <!-- 父 pom 不是 spring-boot-starter-parent，插件版本无人管理，必须显式指定 -->
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- macOS 外置卷（exFAT）会为写入的每个文件生成 ._* AppleDouble 副本。
                             其中 ._XxxTest.class 会被 surefire 的类扫描当成测试类，
                             报 "Unable to create test class 'com.scaffold.xxx.._XxxTest'" 并中断构建。
                             这里从源头排除，而不是每次构建前手工 find -delete。 -->
                        <excludes>
                            <exclude>**/._*</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>docker</id>
            <build><plugins><plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions><execution>
                    <id>docker-lifecycle</id>
                    <phase>${docker.phase}</phase>
                    <goals><goal>exec</goal></goals>
                    <configuration>
                        <executable>bash</executable>
                        <arguments>
                            <argument>-c</argument>
                            <!-- 从当前模块向上查找部署入口，支持父/子 POM 独立运行。 -->
                            <argument>p="$(cd "$1" &amp;&amp; pwd)"; while [ ! -f "$p/docker/manage.sh" ] &amp;&amp; [ "$p" != "/" ]; do p="$(dirname "$p")"; done; exec bash "$p/docker/manage.sh" "${@:2}"</argument>
                            <argument>docker-manage</argument>
                            <argument>${project.basedir}</argument>
                            <argument>--module</argument><argument>${project.artifactId}</argument>
                            <argument>--root-module</argument><argument>${session.topLevelProject.artifactId}</argument>
                            <argument>--action</argument><argument>${docker.action}</argument>
                            <argument>--data-dir</argument><argument>${docker.data.dir}</argument>
                            <argument>--wait-timeout</argument><argument>${docker.wait.timeout}</argument>
                        </arguments>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>

</project>
